# Dependencies (huge folders, regenerated by npm install)
node_modules/
*/node_modules/
**/node_modules/

# Environment files (contain SECRETS like DB passwords, JWT keys)
.env
.env.local
.env.production
.env.development
**/.env

# React Native / Android build artifacts
android/app/build/
android/.gradle/
android/build/
**/android/app/build/
**/android/.gradle/
**/android/build/

# iOS build artifacts
ios/build/
ios/Pods/
**/ios/build/
**/ios/Pods/

# Expo (just in case)
.expo/
.expo-shared/

# IDE / Editor folders
.vscode/
.idea/
*.iml

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Build outputs
*.apk
*.aab
*.ipa

# Backup / temp files
*.bak
*.tmp
*.zip
*.swp

# Metro bundler cache
.metro-health-check*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


